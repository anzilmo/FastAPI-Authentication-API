# App Settings
APP_NAME="Authentication API"
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30

# Security
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourapp.com
SMTP_FROM_NAME="Authentication API"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# PostgreSQL Database
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://auth_user:Ancil%409072@localhost:5432/auth_db

# Database Details (for reference)
DATABASE_NAME=auth_db
DATABASE_USER=auth_user
DATABASE_PASSWORD=Ancil@9072